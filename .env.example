# SPL - Sphoorthy Premier League Environment Configuration
# Copy this file to .env and configure your production / development environment parameters.

# Flask Application Settings
SECRET_KEY=your_secure_random_flask_secret_key
FLASK_ENV=development
FLASK_APP=run.py

# Database Configuration
DATABASE_URL=sqlite:///instance/spl_auction.db

# Google Identity Services / OAuth Credentials (for Franchise Owner Login)
# Obtain these from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google OAuth Callback / Redirect URI
# IMPORTANT: This MUST exactly match the Authorized Redirect URI in Google Cloud Console.
# Local development example: http://127.0.0.1:5000/auth/google/callback
# PythonAnywhere production example: https://YOUR-USERNAME.pythonanywhere.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Security & Session Settings
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
